<?xml version="1.0" encoding="utf-8"?>
<!-- Zoom slider drawable for the fullscreen overlay. Always white-tinted because
     the overlay sits on top of the camera feed regardless of the Light/Dark theme
     (the preview itself is theme-agnostic). Pairs with `thumb_zoom_seekbar_white.xml`. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
