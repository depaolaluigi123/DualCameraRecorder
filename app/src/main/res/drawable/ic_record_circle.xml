<?xml version="1.0" encoding="utf-8"?>
<!--
  Start-recording icon: a small filled red dot inside a larger red ring. The
  ring is drawn as a hollow circle (two paths combined with evenOdd fill so the
  interior is cut out), then a smaller filled circle sits inside the hole. The
  visual matches the conventional "record" target glyph used by cameras. Tinted
  white when shown inside the fullscreen Record button so the colour comes from
  the button stroke instead of the icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Outer ring: circle at (12,12) radius 10 with a circular hole of radius 6
         carved out via evenOdd fill — yields a thin red ring ~4u thick. -->
    <path
        android:fillColor="#C0392B"
        android:fillType="evenOdd"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,18c-3.31,0 -6,-2.69 -6,-6s2.69,-6 6,-6 6,2.69 6,6 -2.69,6 -6,6z" />
    <!-- Inner dot: solid red circle radius 3, centred at (12,12), small enough to
         read as a dot inside the ring with a visible gap on all sides. -->
    <path
        android:fillColor="#C0392B"
        android:pathData="M12,9a3,3 0 0,0 -3,3a3,3 0 0,0 3,3a3,3 0 0,0 3,-3a3,3 0 0,0 -3,-3z" />
</vector>