<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical "level indicator" for the zoom slider in the Fullscreen Preview
     overlay. Same shape and dimensions as `thumb_zoom_seekbar.xml` (4dp wide,
     24dp tall, rounded corners for the pill look) but hardcoded white so it
     stays visible on top of the camera feed regardless of theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="2dp" />
    <size
        android:width="4dp"
        android:height="24dp" />
</shape>
