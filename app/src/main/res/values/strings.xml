    <!-- Device compatibility alert (shown at app startup) -->
    <string name="compat_alert_title">Device compatibility notice</string>
    <string name="compat_alert_message">This app drives two cameras at once and uses the hardware encoder directly. Behaviour, supported resolutions, frame rates and audio settings vary from device to device — on some phones the dual-camera combination may not work, the preview may freeze, the recording may fail, or the audio may be missing. There are also hardware limits (number of cameras that can run concurrently, max resolution per camera, max audio sample rate) that we cannot bypass. If something does not work as expected, try changing the front / rear camera, the resolution, or the FPS.</string>
    <string name="compat_alert_dont_show_again">Don\'t show this again</string>
